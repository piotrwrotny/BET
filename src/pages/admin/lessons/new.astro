---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { ServerError } from "@/components/auth/ServerError";
import { MarkdownEditor } from "@/components/admin/MarkdownEditor";
import { createClient } from "@/lib/supabase";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const chapterId = Astro.url.searchParams.get("chapter_id") ?? "";
const errorParam = Astro.url.searchParams.get("error");

function safeDecodeURIComponent(value: string | null): string | null {
  if (!value) return null;
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

const errorMessage = safeDecodeURIComponent(errorParam);

let chapterTitle = "";
let bookTitle = "";
let bookId = "";

if (chapterId) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const { data: chapter } = await supabase
      .from("chapters")
      .select("title, book_id")
      .eq("id", chapterId)
      .single();
    chapterTitle = chapter?.title ?? "";
    bookId = chapter?.book_id ?? "";

    if (bookId) {
      const { data: book } = await supabase.from("books").select("title").eq("id", bookId).single();
      bookTitle = book?.title ?? "";
    }
  }
}
---

<AdminLayout title="Nowa lekcja">
  <div class="mb-4 flex items-center gap-2 text-sm text-muted-foreground">
    <a href="/admin/books" class="hover:underline">Książki</a>
    {bookId && <><span>›</span><a href={`/admin/chapters?book_id=${bookId}`} class="hover:underline">{bookTitle}</a></>}
    {chapterId && <><span>›</span><a href={`/admin/lessons?chapter_id=${chapterId}`} class="hover:underline">{chapterTitle}</a></>}
    <span>›</span>
    <span class="text-foreground font-medium">Nowa lekcja</span>
  </div>

  {errorMessage && <ServerError message={errorMessage} />}

  <form method="post" action="/api/admin/lessons" class="space-y-4">
    <input type="hidden" name="chapter_id" value={chapterId} />

    <div class="max-w-lg space-y-1">
      <Label htmlFor="title">Tytuł lekcji *</Label>
      <Input id="title" name="title" type="text" required placeholder="Tytuł lekcji" />
    </div>

    <div class="space-y-1">
      <Label>Treść lekcji * <span class="text-xs text-muted-foreground">(Markdown)</span></Label>
      <MarkdownEditor client:load name="content" className="min-h-96" />
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Utwórz lekcję
      </button>
      <a
        href={chapterId ? `/admin/lessons?chapter_id=${chapterId}` : "/admin/chapters"}
        class="inline-flex h-9 items-center rounded-md border border-border px-4 text-sm text-muted-foreground transition-colors hover:bg-muted"
      >
        Anuluj
      </a>
    </div>
  </form>
</AdminLayout>
