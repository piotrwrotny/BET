---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const { id } = Astro.params;
const { data: book, error } = await supabase
  .from("books")
  .select("id, title, cover_url, description")
  .eq("id", id!)
  .single();

if (error || !book) return new Response(null, { status: 404 });

const errorParam = Astro.url.searchParams.get("error");

function safeDecodeURIComponent(value: string | null): string | null {
  if (!value) return null;
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

const errorMessage = safeDecodeURIComponent(errorParam);
---

<AdminLayout title="Edytuj książkę">
  <div class="mb-4">
    <a href="/admin/books" class="text-muted-foreground text-sm hover:underline">← Książki</a>
  </div>

  {errorMessage && <ServerError message={errorMessage} />}

  <form method="post" action={`/api/admin/books/${book.id}`} class="max-w-lg space-y-4">
    <div class="space-y-1">
      <Label htmlFor="title">Tytuł *</Label>
      <Input id="title" name="title" type="text" required value={book.title} />
    </div>

    <div class="space-y-1">
      <Label htmlFor="cover_url">URL okładki</Label>
      <Input
        id="cover_url"
        name="cover_url"
        type="url"
        value={book.cover_url ?? ""}
        placeholder="https://example.com/cover.jpg"
      />
    </div>

    <div class="space-y-1">
      <Label htmlFor="description">Opis</Label>
      <Textarea id="description" name="description" rows={3} value={book.description ?? ""} />
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
      >
        Zapisz zmiany
      </button>
      <a
        href="/admin/books"
        class="border-border text-muted-foreground hover:bg-muted inline-flex h-9 items-center rounded-md border px-4 text-sm transition-colors"
      >
        Anuluj
      </a>
    </div>
  </form>
</AdminLayout>
