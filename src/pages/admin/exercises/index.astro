---
import AdminLayout from "@/layouts/AdminLayout.astro";
import DeleteButton from "@/components/admin/DeleteButton.astro";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase.server";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const lessonId = Astro.url.searchParams.get("lesson_id");
if (!lessonId) return Astro.redirect("/admin/lessons");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

let pageError: string | null = null;

const { data: lesson, error: lessonError } = await supabase
  .from("lessons")
  .select("id, title, chapter_id")
  .eq("id", lessonId)
  .single();

if (lessonError) pageError = lessonError.message;
if (!lesson) return Astro.redirect("/admin/lessons");

const { data: chapter, error: chapterError } = await supabase
  .from("chapters")
  .select("title, book_id")
  .eq("id", lesson.chapter_id)
  .single();

if (chapterError) pageError = chapterError.message;

let book = null;
let bookError = null;
if (chapter?.book_id) {
  const result = await supabase.from("books").select("title").eq("id", chapter.book_id).single();
  book = result.data;
  bookError = result.error;
}
if (bookError) pageError = bookError.message;

const { data: exercises, error: exercisesError } = await supabase
  .from("exercises")
  .select("id, type, prompt, ord, exercise_keys(id, key_text, ord)")
  .eq("lesson_id", lessonId)
  .order("ord", { ascending: true });

if (exercisesError) pageError = exercisesError.message;

const typeLabel: Record<string, string> = {
  multiple_choice: "MC",
  fill_in_blank: "FIB",
  true_false: "T/F",
  matching: "Match",
  sentence_transformation: "ST",
  open_ended: "Open",
};
---

<AdminLayout title="Ćwiczenia">
  {pageError && <ServerError message={pageError} />}

  <div class="text-muted-foreground mb-4 flex items-center gap-2 text-sm">
    <a href="/admin/books" class="hover:underline">Książki</a>
    {
      chapter?.book_id && (
        <>
          <>
            <span>›</span>
            <a href={`/admin/chapters?book_id=${chapter.book_id}`} class="hover:underline">
              {book?.title ?? "Rozdziały"}
            </a>
          </>
        </>
      )
    }
    <span>›</span>
    <a href={`/admin/lessons?chapter_id=${lesson.chapter_id}`} class="hover:underline">
      {chapter?.title ?? "Lekcje"}
    </a>
    <span>›</span>
    <span class="text-foreground font-medium">{lesson.title}</span>
  </div>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-muted-foreground text-sm">
      {exercises?.length ?? 0}
      {exercises?.length === 1 ? "ćwiczenie" : "ćwiczeń"}
    </p>
    <a
      href={`/admin/exercises/new?lesson_id=${lessonId}`}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
    >
      + Nowe ćwiczenie
    </a>
  </div>

  {
    !exercises || exercises.length === 0 ? (
      <p class="text-muted-foreground text-sm">Brak ćwiczeń. Stwórz pierwsze.</p>
    ) : (
      <div class="border-border rounded-lg border">
        <table class="w-full text-sm">
          <thead class="border-border bg-muted/30 border-b">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Nr</th>
              <th class="px-4 py-3 text-left font-medium">Typ</th>
              <th class="px-4 py-3 text-left font-medium">Treść</th>
              <th class="px-4 py-3 text-left font-medium">Klucze</th>
              <th class="px-4 py-3 text-right font-medium">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {exercises.map((ex) => (
              <tr class="border-border hover:bg-muted/20 border-b last:border-0">
                <td class="text-muted-foreground px-4 py-3">{ex.ord + 1}</td>
                <td class="px-4 py-3">
                  <span class="bg-accent inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium">
                    {typeLabel[ex.type] ?? ex.type}
                  </span>
                </td>
                <td class="text-muted-foreground px-4 py-3">
                  {ex.prompt.slice(0, 60)}
                  {ex.prompt.length > 60 ? "…" : ""}
                </td>
                <td class="text-muted-foreground px-4 py-3">
                  {(ex.exercise_keys as { key_text: string }[])
                    .map((k) => k.key_text)
                    .join(", ")
                    .slice(0, 40) || "—"}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/admin/exercises/${ex.id}/edit?lesson_id=${lessonId}`}
                      class="text-muted-foreground text-xs hover:underline"
                    >
                      Edytuj
                    </a>
                    <DeleteButton
                      url={`/api/admin/exercises/${ex.id}`}
                      title="to ćwiczenie"
                      label="Usuń"
                      redirect={`/admin/exercises?lesson_id=${lessonId}`}
                    />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
