---
/* eslint-disable astro/jsx-a11y/no-noninteractive-element-interactions */
import AdminLayout from "@/layouts/AdminLayout.astro";
import DeleteButton from "@/components/admin/DeleteButton.astro";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

let pageError: string | null = null;
const { data: books, error } = await supabase
  .from("books")
  .select("id, title, cover_url, description, created_at")
  .order("created_at", { ascending: true });

if (error) pageError = error.message;
---

<AdminLayout title="Książki">
  {pageError && <ServerError message={pageError} />}

  <div class="mb-4 flex items-center justify-between">
    <p class="text-muted-foreground text-sm">
      {books?.length ?? 0}
      {books?.length === 1 ? "książka" : "książek"}
    </p>
    <a
      href="/admin/books/new"
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
    >
      + Nowa książka
    </a>
  </div>

  {
    !books || books.length === 0 ? (
      <p class="text-muted-foreground text-sm">Brak książek. Stwórz pierwszą.</p>
    ) : (
      <div class="border-border rounded-lg border">
        <table class="w-full text-sm">
          <thead class="border-border bg-muted/30 border-b">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Okładka</th>
              <th class="px-4 py-3 text-left font-medium">Tytuł</th>
              <th class="px-4 py-3 text-left font-medium">Opis</th>
              <th class="px-4 py-3 text-right font-medium">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {books.map((book) => (
              <tr class="border-border hover:bg-muted/20 border-b last:border-0">
                <td class="px-4 py-3">
                  {book.cover_url ? (
                    <img
                      src={book.cover_url}
                      alt=""
                      class="h-14 w-10 rounded object-cover"
                      onerror="this.style.display='none'"
                    />
                  ) : (
                    <div class="bg-muted text-muted-foreground flex h-14 w-10 items-center justify-center rounded text-xs">
                      —
                    </div>
                  )}
                </td>
                <td class="px-4 py-3 font-medium">{book.title}</td>
                <td class="text-muted-foreground px-4 py-3">
                  {book.description ? book.description.slice(0, 60) + (book.description.length > 60 ? "…" : "") : "—"}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href={`/admin/chapters?book_id=${book.id}`} class="text-xs text-blue-600 hover:underline">
                      Rozdziały
                    </a>
                    <a href={`/admin/books/${book.id}/edit`} class="text-muted-foreground text-xs hover:underline">
                      Edytuj
                    </a>
                    <DeleteButton
                      url={`/api/admin/books/${book.id}`}
                      title={book.title}
                      label="Usuń"
                      redirect="/admin/books"
                    />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
