---
export interface Props {
  src: string | null | undefined;
  alt: string;
  class?: string;
}

const { src, alt, class: className = "" } = Astro.props;

const isSafeUrl =
  typeof src === "string" && /^https?:\/\//i.test(src);
---

{
  isSafeUrl ? (
    <img src={src} alt={alt} class={className} />
  ) : (
    <div
      class:list={[
        "flex items-center justify-center bg-slate-700 text-xs text-slate-400",
        className,
      ]}
      aria-label={alt}
    >
      <span>—</span>
    </div>
  )
}
