---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "Panel admina" } = Astro.props;
const { user } = Astro.locals;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/admin/books", label: "Książki" },
  { href: "/admin/chapters", label: "Rozdziały" },
  { href: "/admin/lessons", label: "Lekcje" },
  { href: "/admin/exercises", label: "Ćwiczenia" },
  { href: "/admin/users", label: "Użytkownicy" },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} — Panel admina</title>
  </head>
  <body class="bg-background text-foreground">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="border-border bg-muted/30 w-56 shrink-0 border-r">
        <div class="border-border flex h-14 items-center border-b px-4">
          <span class="text-foreground text-sm font-semibold">Panel admina</span>
        </div>
        <nav class="flex flex-col gap-1 p-2">
          {
            navLinks.map(({ href, label }) => {
              const isActive = pathname.startsWith(href);
              return (
                <a
                  href={href}
                  class={`rounded-md px-3 py-2 text-sm transition-colors ${
                    isActive
                      ? "bg-accent text-accent-foreground font-medium"
                      : "text-muted-foreground hover:bg-accent hover:text-accent-foreground"
                  }`}
                >
                  {label}
                </a>
              );
            })
          }
        </nav>
        <div class="absolute bottom-4 left-0 w-56 px-2">
          <a
            href="/dashboard"
            class="text-muted-foreground hover:bg-accent hover:text-accent-foreground block rounded-md px-3 py-2 text-sm transition-colors"
          >
            ← Wróć do kursu
          </a>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex flex-1 flex-col">
        <!-- Topbar -->
        <header class="border-border flex h-14 items-center justify-between border-b px-6">
          <h1 class="text-base font-semibold">{title}</h1>
          <span class="text-muted-foreground text-sm">{user?.email}</span>
        </header>

        <!-- Page content -->
        <main class="flex-1 p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
