---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { ExerciseForm } from "@/components/admin/ExerciseForm";
import { createClient } from "@/lib/supabase";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const { id } = Astro.params;
const lessonIdParam = Astro.url.searchParams.get("lesson_id");

const { data: exercise, error } = await supabase
  .from("exercises")
  .select("id, type, prompt, payload, lesson_id, exercise_keys(key_text, ord)")
  .eq("id", id!)
  .single();

if (error || !exercise) return new Response(null, { status: 404 });

const lessonId = lessonIdParam ?? exercise.lesson_id;

const { data: lesson } = await supabase.from("lessons").select("title, chapter_id").eq("id", lessonId).single();

const { data: chapter } = lesson?.chapter_id
  ? await supabase.from("chapters").select("title, book_id").eq("id", lesson.chapter_id).single()
  : { data: null };

const { data: book } = chapter?.book_id
  ? await supabase.from("books").select("title").eq("id", chapter.book_id).single()
  : { data: null };

// Sort keys by ord, extract key_text values
const sortedKeys = (exercise.exercise_keys as { key_text: string; ord: number }[])
  .sort((a, b) => a.ord - b.ord)
  .map((k) => k.key_text);

// Extract type-specific payload
const payload = exercise.payload as {
  options?: string[];
  pairs?: { left: string; right: string }[];
  original?: string;
};
const initialOptions = exercise.type === "multiple_choice" ? (payload.options ?? []) : undefined;
const initialPairs = exercise.type === "matching" ? (payload.pairs ?? []) : undefined;
const initialOriginal = exercise.type === "sentence_transformation" ? (payload.original ?? "") : undefined;

const redirectTo = `/admin/exercises?lesson_id=${lessonId}`;

const editableTypes = [
  "multiple_choice",
  "fill_in_blank",
  "true_false",
  "matching",
  "sentence_transformation",
  "open_ended",
];
const isEditable = editableTypes.includes(exercise.type);
---

<AdminLayout title="Edytuj ćwiczenie">
  <div class="text-muted-foreground mb-4 flex flex-wrap items-center gap-2 text-sm">
    <a href="/admin/books" class="hover:underline">Książki</a>
    {
      chapter?.book_id && (
        <>
          <>
            <span>›</span>
            <a href={`/admin/chapters?book_id=${chapter.book_id}`} class="hover:underline">
              {book?.title ?? "Rozdziały"}
            </a>
          </>
        </>
      )
    }
    {
      lesson?.chapter_id && (
        <>
          <>
            <span>›</span>
            <a href={`/admin/lessons?chapter_id=${lesson.chapter_id}`} class="hover:underline">
              {chapter?.title ?? "Lekcje"}
            </a>
          </>
        </>
      )
    }
    {
      lessonId && (
        <>
          <>
            <span>›</span>
            <a href={`/admin/exercises?lesson_id=${lessonId}`} class="hover:underline">
              {lesson?.title ?? "Ćwiczenia"}
            </a>
          </>
        </>
      )
    }
    <span>›</span>
    <span class="text-foreground font-medium">Edytuj</span>
  </div>

  {
    isEditable ? (
      <ExerciseForm
        client:load
        lessonId={lessonId}
        exerciseId={exercise.id}
        initialType={
          exercise.type as
            | "multiple_choice"
            | "fill_in_blank"
            | "true_false"
            | "matching"
            | "sentence_transformation"
            | "open_ended"
        }
        initialPrompt={exercise.prompt}
        initialOptions={initialOptions}
        initialPairs={initialPairs}
        initialKeys={exercise.type === "sentence_transformation" ? sortedKeys : undefined}
        initialOriginal={initialOriginal}
        initialReferenceAnswer={exercise.type === "open_ended" ? sortedKeys[0] : undefined}
        redirectTo={redirectTo}
      />
    ) : (
      <div class="border-border bg-muted/30 rounded-md border px-4 py-8 text-center">
        <p class="text-muted-foreground text-sm">Ten typ ćwiczenia nie jest jeszcze edytowalny.</p>
        <p class="text-muted-foreground mt-2 text-xs">[{exercise.type}]</p>
      </div>
    )
  }
</AdminLayout>
