---
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { sanitizeHtml } from "@/lib/markdown";
import { uuidSchema } from "@/lib/utils";
import LessonInteractive from "@/components/lesson/LessonInteractive";
const { id } = Astro.params;

const lessonIdResult = uuidSchema.safeParse(id);
if (!lessonIdResult.success) {
  return Astro.redirect("/dashboard?error=Nieprawidłowy identyfikator lekcji.");
}
const lessonId = lessonIdResult.data;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

let pageError: string | null = null;

const {
  data: { user },
} = await supabase.auth.getUser();
if (!user) return Astro.redirect("/auth/signin");

// Fetch lesson + exercises. RLS automatically blocks access if student
// has no user_book_access for this lesson's book.
const { data: lesson, error: lessonError } = await supabase
  .from("lessons")
  .select(
    `
    id, title, content, ord,
    chapters ( id, title, book_id, ord ),
    exercises ( id, type, prompt, payload, ord )
  `,
  )
  .eq("id", lessonId)
  .single();

if (lessonError || !lesson) {
  return Astro.redirect("/dashboard?error=Nie udało się załadować lekcji.");
}

// Parse Markdown → HTML and sanitize before injection
const contentHtml = sanitizeHtml((await marked.parse(lesson.content)) as string);
// Sort exercises by ord
type Exercise = {
  id: string;
  type: string;
  prompt: string;
  payload: Record<string, unknown>;
  ord: number;
};
const exercises = ([...(lesson.exercises ?? [])] as Exercise[]).sort((a, b) => a.ord - b.ord);

// S-06: every exercise except open_ended is closed and must be solved to complete the lesson
const closedExerciseCount = exercises.filter((e) => e.type !== "open_ended").length;

// Check if already completed
const { data: progressRow } = await supabase
  .from("lesson_progress")
  .select("lesson_id")
  .eq("lesson_id", lessonId)
  .maybeSingle();

const isAlreadyCompleted = progressRow !== null;

// For review mode: fetch correct answers server-side for all closed exercises.
// Keys never reach the client before completion.
let correctAnswers: Record<string, string> = {};
if (isAlreadyCompleted) {
  const closedIds = exercises.filter((e) => e.type !== "open_ended").map((e) => e.id);
  if (closedIds.length > 0) {
    const { data: keys } = await supabase
      .from("exercise_keys")
      .select("exercise_id, key_text, key_metadata")
      .in("exercise_id", closedIds);
    for (const k of keys ?? []) {
      const isRefOnly = (k.key_metadata as Record<string, unknown> | null)?.is_reference_only === true;
      if (!isRefOnly && !correctAnswers[k.exercise_id as string]) {
        correctAnswers[k.exercise_id as string] = k.key_text as string;
      }
    }
  }
}

// Chapter info for breadcrumb
const chapter =
  ((lesson.chapters as { id: string; title: string; book_id: string; ord: number }[] | null) ?? [])[0] ?? null;

// --- S-05: Sequential navigation ---
// Fetch all lessons in this chapter to determine prev/next within chapter
const { data: siblings, error: siblingsError } = chapter
  ? await supabase
      .from("lessons")
      .select("id, title, ord")
      .eq("chapter_id", chapter.id)
      .order("ord", { ascending: true })
  : { data: [], error: null };

if (siblingsError) {
  pageError = "Nie udało się pobrać listy lekcji w rozdziale.";
}

const sibs = siblings ?? [];
const currentIdx = sibs.findIndex((s) => s.id === lesson.id);

type NavLesson = { id: string; title: string; crossChapterTitle?: string } | null;

let prevLesson: NavLesson = currentIdx > 0 ? { id: sibs[currentIdx - 1].id, title: sibs[currentIdx - 1].title } : null;

let nextLesson: NavLesson =
  currentIdx < sibs.length - 1 ? { id: sibs[currentIdx + 1].id, title: sibs[currentIdx + 1].title } : null;

// Cross-chapter boundary: only query when at first/last lesson of chapter
if (!prevLesson && chapter && !pageError) {
  const { data: prevCh, error: prevChError } = await supabase
    .from("chapters")
    .select("id, title")
    .eq("book_id", chapter.book_id)
    .lt("ord", chapter.ord)
    .order("ord", { ascending: false })
    .limit(1)
    .maybeSingle();
  if (prevChError) {
    pageError = "Nie udało się pobrać poprzedniego rozdziału.";
  } else if (prevCh) {
    const { data: prevLessonRow, error: prevLessonError } = await supabase
      .from("lessons")
      .select("id, title")
      .eq("chapter_id", prevCh.id)
      .order("ord", { ascending: false })
      .limit(1)
      .maybeSingle();
    if (prevLessonError) {
      pageError = "Nie udało się pobrać poprzedniej lekcji.";
    } else if (prevLessonRow) {
      prevLesson = { id: prevLessonRow.id, title: prevLessonRow.title, crossChapterTitle: prevCh.title };
    }
  }
}

if (!nextLesson && chapter && !pageError) {
  const { data: nextCh, error: nextChError } = await supabase
    .from("chapters")
    .select("id, title")
    .eq("book_id", chapter.book_id)
    .gt("ord", chapter.ord)
    .order("ord", { ascending: true })
    .limit(1)
    .maybeSingle();
  if (nextChError) {
    pageError = "Nie udało się pobrać następnego rozdziału.";
  } else if (nextCh) {
    const { data: nextLessonRow, error: nextLessonError } = await supabase
      .from("lessons")
      .select("id, title")
      .eq("chapter_id", nextCh.id)
      .order("ord", { ascending: true })
      .limit(1)
      .maybeSingle();
    if (nextLessonError) {
      pageError = "Nie udało się pobrać następnej lekcji.";
    } else if (nextLessonRow) {
      nextLesson = { id: nextLessonRow.id, title: nextLessonRow.title, crossChapterTitle: nextCh.title };
    }
  }
}

// Chapter completion badge (FR-016) — query chapter_progress view
const { data: chapterProgress, error: chapterProgressError } = chapter
  ? await supabase
      .from("chapter_progress")
      .select("lessons_total, lessons_completed, completed_at")
      .eq("chapter_id", chapter.id)
      .maybeSingle()
  : { data: null, error: null };

if (chapterProgressError) {
  pageError = "Nie udało się pobrać postępu rozdziału.";
}

const isChapterCompleted = !!chapterProgress?.completed_at;

if (pageError) {
  return Astro.redirect(`/dashboard?error=${encodeURIComponent(pageError)}`);
}
---

<Layout title={`${lesson.title} — BET`}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800">
    <!-- Lesson header: Dashboard + prev + badges + next -->
    <header class="border-b border-white/10 bg-white/5 px-6 py-4">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4">
        <!-- Left: back + prev -->
        <div class="flex items-center gap-4 text-sm text-slate-400">
          <a href="/dashboard" class="transition-colors hover:text-white">← Dashboard</a>
          {
            prevLesson && (
              <a href={`/lessons/${prevLesson.id}`} class="transition-colors hover:text-white">
                {prevLesson.crossChapterTitle ? (
                  <>
                    ← <span class="text-slate-500">{prevLesson.crossChapterTitle}:</span> {prevLesson.title}
                  </>
                ) : (
                  <>← {prevLesson.title}</>
                )}
              </a>
            )
          }
        </div>
        <!-- Right: badges + next -->
        <div class="flex items-center gap-3 text-sm">
          {
            isChapterCompleted && (
              <span class="rounded-full bg-blue-500/20 px-3 py-1 text-xs font-medium text-blue-400">
                ✓ Rozdział ukończony!
              </span>
            )
          }
          {
            isAlreadyCompleted && (
              <span class="rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-medium text-emerald-400">
                ✓ Ukończona
              </span>
            )
          }
          {
            nextLesson && (
              <a href={`/lessons/${nextLesson.id}`} class="text-slate-400 transition-colors hover:text-white">
                {nextLesson.crossChapterTitle ? <>{nextLesson.crossChapterTitle} →</> : <>{nextLesson.title} →</>}
              </a>
            )
          }
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-10">
      <!-- Breadcrumb -->
      {chapter && <p class="mb-2 text-xs text-slate-500">{chapter.title}</p>}

      <!-- Lesson title -->
      <h1 class="mb-8 text-3xl font-bold text-white">{lesson.title}</h1>

      <!-- Lesson content (Markdown → HTML) -->
      {/* eslint-disable-next-line astro/no-set-html-directive */}
      <article class="lesson-content mb-10" set:html={contentHtml} />

      <!-- Interactive exercises + completion button -->
      <LessonInteractive
        client:load
        lessonId={lesson.id}
        exercises={exercises}
        isAlreadyCompleted={isAlreadyCompleted}
        closedExerciseCount={closedExerciseCount}
        correctAnswers={correctAnswers}
      />
    </main>
  </div>
</Layout>

<style>
  .lesson-content {
    color: rgb(226 232 240); /* slate-200 */
    line-height: 1.75;
  }
  .lesson-content h1,
  .lesson-content h2,
  .lesson-content h3 {
    color: #fff;
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .lesson-content h2 {
    font-size: 1.4rem;
  }
  .lesson-content h3 {
    font-size: 1.15rem;
  }
  .lesson-content p {
    margin-bottom: 1em;
  }
  .lesson-content strong {
    color: #fff;
    font-weight: 600;
  }
  .lesson-content em {
    color: rgb(186 230 253); /* sky-200 */
  }
  .lesson-content ul,
  .lesson-content ol {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .lesson-content li {
    margin-bottom: 0.25em;
  }
  .lesson-content code {
    background: rgb(30 41 59); /* slate-800 */
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.875em;
    color: rgb(186 230 253);
  }
  .lesson-content pre {
    background: rgb(15 23 42); /* slate-900 */
    border-radius: 8px;
    padding: 1em;
    overflow-x: auto;
    margin-bottom: 1em;
  }
  .lesson-content blockquote {
    border-left: 3px solid rgb(99 102 241); /* indigo-500 */
    padding-left: 1em;
    color: rgb(148 163 184); /* slate-400 */
    font-style: italic;
  }
</style>
