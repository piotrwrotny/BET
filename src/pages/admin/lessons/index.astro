---
import AdminLayout from "@/layouts/AdminLayout.astro";
import DeleteButton from "@/components/admin/DeleteButton.astro";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase.server";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const chapterId = Astro.url.searchParams.get("chapter_id");
if (!chapterId) return Astro.redirect("/admin/chapters");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

let pageError: string | null = null;

const { data: chapter, error: chapterError } = await supabase
  .from("chapters")
  .select("id, title, book_id")
  .eq("id", chapterId)
  .single();

if (chapterError) pageError = chapterError.message;
if (!chapter) return Astro.redirect("/admin/chapters");

const { data: book, error: bookError } = await supabase
  .from("books")
  .select("id, title")
  .eq("id", chapter.book_id)
  .single();

if (bookError) pageError = bookError.message;

const { data: lessons, error: lessonsError } = await supabase
  .from("lessons")
  .select("id, title, content, ord")
  .eq("chapter_id", chapterId)
  .order("ord", { ascending: true });

if (lessonsError) pageError = lessonsError.message;
---

<AdminLayout title="Lekcje">
  {pageError && <ServerError message={pageError} />}

  <div class="text-muted-foreground mb-4 flex items-center gap-2 text-sm">
    <a href="/admin/books" class="hover:underline">Książki</a>
    <span>›</span>
    <a href={`/admin/chapters?book_id=${chapter.book_id}`} class="hover:underline">
      {book?.title ?? "Rozdziały"}
    </a>
    <span>›</span>
    <span class="text-foreground font-medium">{chapter.title}</span>
  </div>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-muted-foreground text-sm">
      {lessons?.length ?? 0}
      {lessons?.length === 1 ? "lekcja" : "lekcji"}
    </p>
    <a
      href={`/admin/lessons/new?chapter_id=${chapterId}`}
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
    >
      + Nowa lekcja
    </a>
  </div>

  {
    !lessons || lessons.length === 0 ? (
      <p class="text-muted-foreground text-sm">Brak lekcji. Stwórz pierwszą.</p>
    ) : (
      <div class="border-border rounded-lg border">
        <table class="w-full text-sm">
          <thead class="border-border bg-muted/30 border-b">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Nr</th>
              <th class="px-4 py-3 text-left font-medium">Tytuł</th>
              <th class="px-4 py-3 text-left font-medium">Podgląd treści</th>
              <th class="px-4 py-3 text-right font-medium">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {lessons.map((lesson) => (
              <tr class="border-border hover:bg-muted/20 border-b last:border-0">
                <td class="text-muted-foreground px-4 py-3">{lesson.ord + 1}</td>
                <td class="px-4 py-3 font-medium">{lesson.title}</td>
                <td class="text-muted-foreground px-4 py-3">
                  {lesson.content.slice(0, 60)}
                  {lesson.content.length > 60 ? "…" : ""}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href={`/admin/exercises?lesson_id=${lesson.id}`} class="text-xs text-blue-600 hover:underline">
                      Ćwiczenia
                    </a>
                    <a
                      href={`/admin/lessons/${lesson.id}/edit?chapter_id=${chapterId}`}
                      class="text-muted-foreground text-xs hover:underline"
                    >
                      Edytuj
                    </a>
                    <DeleteButton
                      url={`/api/admin/lessons/${lesson.id}`}
                      title={lesson.title}
                      label="Usuń"
                      redirect={`/admin/lessons?chapter_id=${chapterId}`}
                    />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
