---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase.server";

export const prerender = false;

if (Astro.locals.role !== "admin") {
  return Astro.redirect("/dashboard");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const { id } = Astro.params;
// book_id may come from query param (from chapters list link)
const bookIdParam = Astro.url.searchParams.get("book_id");

const { data: chapter, error } = await supabase.from("chapters").select("id, title, book_id").eq("id", id!).single();

if (error || !chapter) return new Response(null, { status: 404 });

const bookId = bookIdParam ?? chapter.book_id;

const { data: book } = await supabase.from("books").select("title").eq("id", bookId).single();

const errorParam = Astro.url.searchParams.get("error");

function safeDecodeURIComponent(value: string | null): string | null {
  if (!value) return null;
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

const errorMessage = safeDecodeURIComponent(errorParam);
---

<AdminLayout title="Edytuj rozdział">
  <div class="text-muted-foreground mb-4 flex items-center gap-2 text-sm">
    <a href="/admin/books" class="hover:underline">Książki</a>
    <span>›</span>
    <a href={`/admin/chapters?book_id=${bookId}`} class="hover:underline">
      {book?.title ?? "Rozdziały"}
    </a>
    <span>›</span>
    <span class="text-foreground font-medium">Edytuj</span>
  </div>

  {errorMessage && <ServerError message={errorMessage} />}

  <form method="post" action={`/api/admin/chapters/${chapter.id}`} class="max-w-lg space-y-4">
    <input type="hidden" name="book_id" value={bookId} />

    <div class="space-y-1">
      <Label htmlFor="title">Tytuł rozdziału *</Label>
      <Input id="title" name="title" type="text" required value={chapter.title} />
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 items-center rounded-md px-4 text-sm font-medium transition-colors"
      >
        Zapisz zmiany
      </button>
      <a
        href={`/admin/chapters?book_id=${bookId}`}
        class="border-border text-muted-foreground hover:bg-muted inline-flex h-9 items-center rounded-md border px-4 text-sm transition-colors"
      >
        Anuluj
      </a>
    </div>
  </form>
</AdminLayout>
