---
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import LessonInteractive from "@/components/lesson/LessonInteractive";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const {
  data: { user },
} = await supabase.auth.getUser();
if (!user) return Astro.redirect("/auth/signin");

// Fetch lesson + exercises. RLS automatically blocks access if student
// has no user_book_access for this lesson's book.
const { data: lesson } = await supabase
  .from("lessons")
  .select(
    `
    id, title, content, ord,
    chapters ( id, title, book_id, ord ),
    exercises ( id, type, prompt, payload, ord )
  `,
  )
  .eq("id", id as string)
  .single();

// 0 rows = bad ID or RLS blocked → send back to dashboard
if (!lesson) return Astro.redirect("/dashboard");

// Parse Markdown → HTML (sync, no async extensions configured)
const contentHtml = marked.parse(lesson.content) as string;

// Sort exercises by ord
type Exercise = {
  id: string;
  type: string;
  prompt: string;
  payload: Record<string, unknown>;
  ord: number;
};
const exercises = ([...(lesson.exercises ?? [])] as Exercise[]).sort(
  (a, b) => a.ord - b.ord,
);

// S-01: only multiple_choice is interactive; other closed types unblocked until S-06/S-07
const closedExerciseCount = exercises.filter((e) => e.type === "multiple_choice").length;

// Check if already completed
const { data: progressRow } = await supabase
  .from("lesson_progress")
  .select("lesson_id")
  .eq("lesson_id", id as string)
  .maybeSingle();

const isAlreadyCompleted = progressRow !== null;

// For review mode: fetch correct answers server-side so completed MC exercises
// can highlight the correct option. Keys never reach the client before completion.
let correctAnswers: Record<string, string> = {};
if (isAlreadyCompleted) {
  const mcIds = exercises.filter((e) => e.type === "multiple_choice").map((e) => e.id);
  if (mcIds.length > 0) {
    const { data: keys } = await supabase
      .from("exercise_keys")
      .select("exercise_id, key_text, key_metadata")
      .in("exercise_id", mcIds);
    for (const k of keys ?? []) {
      const isRefOnly = (k.key_metadata as Record<string, unknown> | null)?.is_reference_only === true;
      if (!isRefOnly && !correctAnswers[k.exercise_id as string]) {
        correctAnswers[k.exercise_id as string] = k.key_text as string;
      }
    }
  }
}

// Chapter info for breadcrumb
const chapter = lesson.chapters as {
  id: string;
  title: string;
  book_id: string;
  ord: number;
} | null;

// --- S-05: Sequential navigation ---
// Fetch all lessons in this chapter to determine prev/next within chapter
const { data: siblings } = chapter
  ? await supabase
      .from("lessons")
      .select("id, title, ord")
      .eq("chapter_id", chapter.id)
      .order("ord", { ascending: true })
  : { data: [] };

const sibs = siblings ?? [];
const currentIdx = sibs.findIndex((s) => s.id === lesson.id);

type NavLesson = { id: string; title: string; crossChapterTitle?: string } | null;

let prevLesson: NavLesson =
  currentIdx > 0 ? { id: sibs[currentIdx - 1].id, title: sibs[currentIdx - 1].title } : null;

let nextLesson: NavLesson =
  currentIdx < sibs.length - 1
    ? { id: sibs[currentIdx + 1].id, title: sibs[currentIdx + 1].title }
    : null;

// Cross-chapter boundary: only query when at first/last lesson of chapter
if (!prevLesson && chapter) {
  const { data: prevCh } = await supabase
    .from("chapters")
    .select("id, title, lessons(id, title, ord)")
    .eq("book_id", chapter.book_id)
    .lt("ord", chapter.ord)
    .order("ord", { ascending: false })
    .limit(1)
    .maybeSingle();
  if (prevCh) {
    const sorted = ((prevCh.lessons ?? []) as { id: string; title: string; ord: number }[]).sort(
      (a, b) => b.ord - a.ord,
    );
    if (sorted[0])
      prevLesson = { id: sorted[0].id, title: sorted[0].title, crossChapterTitle: prevCh.title };
  }
}

if (!nextLesson && chapter) {
  const { data: nextCh } = await supabase
    .from("chapters")
    .select("id, title, lessons(id, title, ord)")
    .eq("book_id", chapter.book_id)
    .gt("ord", chapter.ord)
    .order("ord", { ascending: true })
    .limit(1)
    .maybeSingle();
  if (nextCh) {
    const sorted = ((nextCh.lessons ?? []) as { id: string; title: string; ord: number }[]).sort(
      (a, b) => a.ord - b.ord,
    );
    if (sorted[0])
      nextLesson = { id: sorted[0].id, title: sorted[0].title, crossChapterTitle: nextCh.title };
  }
}

// Chapter completion badge (FR-016) — query chapter_progress view
const { data: chapterProgress } = chapter
  ? await supabase
      .from("chapter_progress")
      .select("lessons_total, lessons_completed, completed_at")
      .eq("chapter_id", chapter.id)
      .maybeSingle()
  : { data: null };

const isChapterCompleted = !!(chapterProgress?.completed_at);
---

<Layout title={`${lesson.title} — BET`}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800">
    <!-- Zone 1: slim top bar — Dashboard back + lesson/chapter status -->
    <header class="border-b border-white/10 bg-white/5 px-6 py-3">
      <div class="mx-auto flex max-w-3xl items-center justify-between">
        <a href="/dashboard" class="flex items-center gap-1.5 text-sm text-slate-400 hover:text-white transition-colors">
          ‹ Dashboard
        </a>
        <div class="flex items-center gap-3">
          {isChapterCompleted && (
            <span class="flex items-center gap-1 text-xs text-blue-400">
              <span>✓</span><span>Rozdział ukończony</span>
            </span>
          )}
          {isAlreadyCompleted && (
            <span class="rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-xs font-medium text-emerald-400">
              ✓ Ukończona
            </span>
          )}
        </div>
      </div>
    </header>

    <!-- Zone 2: lesson nav bar — prev / next with truncated titles -->
    {(prevLesson || nextLesson) && (
      <nav class="border-b border-white/5 bg-slate-900/40 px-6 py-2">
        <div class="mx-auto flex max-w-3xl items-center justify-between gap-4">
          <!-- Prev -->
          <div class="min-w-0 flex-1">
            {prevLesson ? (
              <a
                href={`/lessons/${prevLesson.id}`}
                class="group flex items-center gap-2 text-slate-500 hover:text-slate-300 transition-colors"
              >
                <span class="shrink-0 text-xl leading-none">‹</span>
                <div class="min-w-0">
                  {prevLesson.crossChapterTitle && (
                    <p class="truncate text-[10px] text-slate-600 group-hover:text-slate-500 leading-tight">
                      {prevLesson.crossChapterTitle}
                    </p>
                  )}
                  <p class="truncate text-xs leading-tight">{prevLesson.title}</p>
                </div>
              </a>
            ) : <span />}
          </div>
          <!-- Divider -->
          <div class="h-6 w-px shrink-0 bg-white/10" />
          <!-- Next -->
          <div class="min-w-0 flex-1 text-right">
            {nextLesson ? (
              <a
                href={`/lessons/${nextLesson.id}`}
                class="group flex items-center justify-end gap-2 text-slate-500 hover:text-slate-300 transition-colors"
              >
                <div class="min-w-0">
                  {nextLesson.crossChapterTitle && (
                    <p class="truncate text-[10px] text-slate-600 group-hover:text-slate-500 leading-tight">
                      {nextLesson.crossChapterTitle}
                    </p>
                  )}
                  <p class="truncate text-xs leading-tight">{nextLesson.title}</p>
                </div>
                <span class="shrink-0 text-xl leading-none">›</span>
              </a>
            ) : <span />}
          </div>
        </div>
      </nav>
    )}

    <main class="mx-auto max-w-3xl px-6 py-10">
      <!-- Breadcrumb -->
      {chapter && <p class="mb-2 text-xs text-slate-500">{chapter.title}</p>}

      <!-- Lesson title -->
      <h1 class="mb-8 text-3xl font-bold text-white">{lesson.title}</h1>

      <!-- Lesson content (Markdown → HTML) -->
      <article class="lesson-content mb-10" set:html={contentHtml} />

      <!-- Interactive exercises + completion button -->
      <LessonInteractive
        client:load
        lessonId={lesson.id}
        exercises={exercises}
        isAlreadyCompleted={isAlreadyCompleted}
        closedExerciseCount={closedExerciseCount}
        correctAnswers={correctAnswers}
      />
    </main>
  </div>
</Layout>

<style>
  .lesson-content {
    color: rgb(226 232 240); /* slate-200 */
    line-height: 1.75;
  }
  .lesson-content h1,
  .lesson-content h2,
  .lesson-content h3 {
    color: #fff;
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .lesson-content h2 { font-size: 1.4rem; }
  .lesson-content h3 { font-size: 1.15rem; }
  .lesson-content p { margin-bottom: 1em; }
  .lesson-content strong { color: #fff; font-weight: 600; }
  .lesson-content em { color: rgb(186 230 253); /* sky-200 */ }
  .lesson-content ul,
  .lesson-content ol {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }
  .lesson-content li { margin-bottom: 0.25em; }
  .lesson-content code {
    background: rgb(30 41 59); /* slate-800 */
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.875em;
    color: rgb(186 230 253);
  }
  .lesson-content pre {
    background: rgb(15 23 42); /* slate-900 */
    border-radius: 8px;
    padding: 1em;
    overflow-x: auto;
    margin-bottom: 1em;
  }
  .lesson-content blockquote {
    border-left: 3px solid rgb(99 102 241); /* indigo-500 */
    padding-left: 1em;
    color: rgb(148 163 184); /* slate-400 */
    font-style: italic;
  }
</style>
