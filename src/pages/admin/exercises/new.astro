---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { ExerciseForm } from "@/components/admin/ExerciseForm";
import { createClient } from "@/lib/supabase";

const lessonId = Astro.url.searchParams.get("lesson_id") ?? "";

let lessonTitle = "";
let chapterId = "";
let chapterTitle = "";
let bookId = "";
let bookTitle = "";

if (lessonId) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const { data: lesson } = await supabase
      .from("lessons")
      .select("title, chapter_id")
      .eq("id", lessonId)
      .single();
    lessonTitle = lesson?.title ?? "";
    chapterId = lesson?.chapter_id ?? "";

    if (chapterId) {
      const { data: chapter } = await supabase
        .from("chapters")
        .select("title, book_id")
        .eq("id", chapterId)
        .single();
      chapterTitle = chapter?.title ?? "";
      bookId = chapter?.book_id ?? "";

      if (bookId) {
        const { data: book } = await supabase.from("books").select("title").eq("id", bookId).single();
        bookTitle = book?.title ?? "";
      }
    }
  }
}

const redirectTo = `/admin/exercises?lesson_id=${lessonId}`;
---

<AdminLayout title="Nowe ćwiczenie">
  <div class="mb-4 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    <a href="/admin/books" class="hover:underline">Książki</a>
    {bookId && <><span>›</span><a href={`/admin/chapters?book_id=${bookId}`} class="hover:underline">{bookTitle}</a></>}
    {chapterId && <><span>›</span><a href={`/admin/lessons?chapter_id=${chapterId}`} class="hover:underline">{chapterTitle}</a></>}
    {lessonId && <><span>›</span><a href={`/admin/exercises?lesson_id=${lessonId}`} class="hover:underline">{lessonTitle}</a></>}
    <span>›</span>
    <span class="text-foreground font-medium">Nowe ćwiczenie</span>
  </div>

  <ExerciseForm client:load lessonId={lessonId} redirectTo={redirectTo} />
</AdminLayout>
