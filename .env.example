SUPABASE_URL=###
SUPABASE_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###

# Optional: internal AI models for the review agent (M5L2/M5L3)
# Kimi K2.7-Code always emits reasoning text and is not suitable for raw JSON evals.
GUCIO_BASE_URL=http://gucio-kimi-k27-code.llm.ai.asseco.pl/v1
GUCIO_API_KEY=
GUCIO_MODEL=moonshotai/Kimi-K2.7-Code

# Gemma 4 31B returns clean JSON and passes the promptfoo eval.
GEMMA_BASE_URL=http://gemma4-31b.llm.ai.asseco.pl/v1
GEMMA_API_KEY=
GEMMA_MODEL=google/gemma-4-31B

# Generic LLM provider config used by scripts/review.ts
# Supported providers: gemma, gucio, openrouter, github
LLM_PROVIDER=github
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1

# OpenRouter alternative for public CI runners
OPENROUTER_API_KEY=

# GitHub token used by provider=github (can be the same as GITHUB_TOKEN)
GITHUB_TOKEN=